# FinOS AI — Next.js 本地配置模板
# 复制为 .env.local 后替换所有 CHANGE_ME 值。
# .env.local 已被 Git 忽略，禁止提交真实密钥。

# 工作区 HttpOnly 会话签名。生产预览与部署必须提供高强度随机值。
FINOS_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS

# 模型 API Key 与模型配置文件的 AES-256-GCM 派生密钥。
FINOS_DATA_KEY=CHANGE_ME_WITH_ANOTHER_INDEPENDENT_RANDOM_SECRET

# 仅在同时启动 FastAPI 时填写；空值表示使用 Next.js 同源接口。
NEXT_PUBLIC_BACKEND_URL=

# 可选：Docker standalone 输出。
FINOS_STANDALONE=0
