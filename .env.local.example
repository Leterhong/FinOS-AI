# ============================================================
# FinOS AI — LLM 服务端密钥模板
# 使用方式：复制本文件为 .env.local 并填入真实密钥
#   cp .env.local.example .env.local
# .env.local 已被 .gitignore 忽略，切勿将真实密钥提交到仓库。
#
# 所有 Key 仅在【服务端 Runtime】读取（Next.js Route Handler），
# 禁止加 NEXT_PUBLIC_ 前缀 —— 否则密钥会泄露到浏览器客户端 bundle。
#
# 前置：运行环境需能访问对应服务商的 API 域名
#   （api.openai.com / api.deepseek.com / api.anthropic.com 等）
# ============================================================

# OpenAI（现金流分析 / 投资规划 / 信息提取 / 总结 / 规划 默认走 OpenAI）
OPENAI_API_KEY=sk-your-openai-key-here

# DeepSeek（推理类：风险评估 / 退休规划 / 任务规划 默认走 DeepSeek）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Anthropic Claude（长上下文场景）
ANTHROPIC_API_KEY=sk-ant-your-claude-key-here

# 阿里通义千问 Qwen（视觉类场景）
QWEN_API_KEY=sk-your-qwen-key-here

# 字节 Seed / 豆包（reasoning / analysis / writing 备用）
SEED_API_KEY=sk-your-seed-key-here
