# FinOS AI Backend 环境配置模板（复制为 backend/.env 后填写，禁止提交 .env 到 Git）

# 数据库：生产用 PostgreSQL；不配置时默认本地 SQLite（backend/data/finos.db）
# DATABASE_URL=postgresql://finos:password@localhost:5432/finos_ai
DATABASE_URL=

# Redis（可选，不可用时自动降级进程内缓存）
REDIS_URL=redis://localhost:6379/0

# JWT 密钥：必须替换为至少 32 字符的高熵随机值。
# 占位值/弱密钥在生产环境会直接拒绝启动。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-me-to-a-long-random-string

# 模型端点出站边界：是否允许 Base URL 指向本机/内网（自托管 Ollama 场景）。
# 留空时开发环境放行、生产禁止；云元数据段任何模式下都拒绝。
# AI_ALLOW_PRIVATE_ENDPOINTS=

# 可信反向代理地址；仅这些来源的 X-Forwarded-For 会参与限流
TRUSTED_PROXY_IPS=127.0.0.1,::1

# AES-256-GCM 主密钥（URL-safe Base64 编码的 32 字节，不可留空）
ENCRYPTION_MASTER_KEY=

# 允许的前端来源
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
