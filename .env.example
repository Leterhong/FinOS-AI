# ============================================================
# FinOS AI — 环境变量模板（Phase 7.5 #366）
#
# 使用方式：
#   自动： bash deploy.sh          （首次运行自动复制本文件为 .env 并生成随机密钥）
#   手动： cp .env.example .env    然后把所有 CHANGE_ME_* 替换为真实值
#
# 安全提醒：
#   · .env 已在 .gitignore / .dockerignore 中，禁止提交到版本库
#   · ENCRYPTION_MASTER_KEY 一旦丢失，此前加密存储的模型 / 数据源 API Key 将无法解密
# ============================================================

# ── 对外端口 ────────────────────────────────────────────────
# nginx 入口端口（浏览器访问 http://localhost:<HTTP_PORT>）
HTTP_PORT=80
# 以下两个端口仅绑定 127.0.0.1，供本机调试直连，不对公网暴露
WEB_PORT=3000
API_PORT=8300

# ── 应用 ────────────────────────────────────────────────────
APP_NAME=FinOS AI Backend
DEBUG=false
# 允许跨域的前端来源（生产改为你的真实域名，逗号分隔）
CORS_ORIGINS=http://localhost,http://localhost:3000

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=finos
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=finos
# DATABASE_URL 由 docker-compose 依据上面三项自动拼装，无需手填。
# 若要连接外部数据库，可在此显式覆盖（密码含特殊字符需 URL 编码）：
# DATABASE_URL=postgresql://finos:password@your-db-host:5432/finos

# ── Redis（不可用时后端自动降级为进程内缓存）────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# REDIS_URL 同样由 compose 自动拼装，需要外部 Redis 时再覆盖：
# REDIS_URL=redis://:password@your-redis-host:6379/0

# ── JWT 会话 ────────────────────────────────────────────────
# 强随机值，至少 32 字节
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES_LONG
JWT_ALGORITHM=HS256
# Access Token 有效期：7 天（分钟）
JWT_EXPIRE_MINUTES=10080
# Refresh Token 有效期：30 天（天）。前端用 /api/auth/refresh 轮换续期。
JWT_REFRESH_EXPIRE_DAYS=30

# ── AES-256-GCM 字段级加密主密钥 ────────────────────────────
# URL-safe Base64 编码的 32 字节随机值，生成命令：
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_MASTER_KEY=CHANGE_ME_BASE64_32BYTES_ENCRYPTION_KEY

# ── 前端侧数据加密密钥 ──────────────────────────────────────
# Next 服务端用它派生密钥（scrypt）加密本地存储的财务数据与模型 API Key。
# ⚠️ 生产环境（NODE_ENV=production）未配置时前端会**直接抛错拒绝服务**：
#    开源仓库中的开发兜底密钥人人可见，用于生产等同于未加密。
# 生成： python -c "import secrets;print(secrets.token_urlsafe(32))"
FINOS_DATA_KEY=CHANGE_ME_FINOS_DATA_KEY

# 会话签名密钥。留空则回退使用 FINOS_DATA_KEY，一般无需单独配置。
# FINOS_AUTH_SECRET=

# ── 速率限制 ────────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=300
AI_RATE_LIMIT_PER_MINUTE=30
AI_MAX_TOKENS=8192
AI_MAX_INPUT_CHARS=100000

# ── 前端 ────────────────────────────────────────────────────
# 浏览器侧请求后端的基址（会被拼成 `${BASE}/api<path>`，backendApi 自带 /api）。
# Docker 一键部署：留空（或写同源 /api 会被去尾），请求走同源 /api，
#   由 nginx 把 /api 转发到 api 服务。⚠️ 不要写成 /api，否则会变成 /api/api 双前缀。
# 前后端分域名部署时改为完整源站，例如 https://api.your-domain.com
NEXT_PUBLIC_BACKEND_URL=

# ── 数据备份 ────────────────────────────────────────────────
# 整库逻辑备份接口 GET /api/backup/database 的访问口令（管理员用）。
# 请求需在 HTTP 头 X-Backup-Key 携带此值；留空则该接口一律拒绝访问。
# 生成： python -c "import secrets;print(secrets.token_urlsafe(32))"
BACKUP_API_KEY=

# ── 数据迁移（仅首次从旧版 .data 目录导入历史数据时置 true）──
MIGRATE_LEGACY_DATA=false

# ── AI 模型（可选）──────────────────────────────────────────
# FinOS AI 采用 Bring Your Own Model：模型 API Key 由用户在
# 「AI 模型中心」页面自行填写并加密入库，无需在此配置。
# 仅当需要为全站配置一个默认兜底模型时才填写：
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
